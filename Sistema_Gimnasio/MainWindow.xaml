<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Sistema_Gimnasio.MainWindow"
        Height="720" Width="1080" WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <!-- Design: C# WPF UI | How to Design Flat Data Table Dashboard in WPF (Customize Datagrid) -->
    <Border Background="White" CornerRadius="30" 
            MouseDown= "Border_MouseDown" 
            MouseLeftButtonDown= "Border_MouseLeftButtonDown" Margin="0,0,0,-6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--Menu izquierdo-->
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--Icono del menú-->
            <Button Margin="20 28 0 35" Style="{StaticResource topButton}">
                <Icon:PackIconMaterial Kind="Menu" Width="15" Height="15"/>
            </Button>
            <!--Panel de Inicio-->
            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Height="32" Margin="0,10,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="minimizeButton" Grid.Column="0" Style="{DynamicResource topButton}" Click="minimizeButton_Click">
                    <Icon:PackIconMaterial Kind="WindowMinimize" Width="15" Height="15"/>
                </Button>
                <Button x:Name="maximizingButton" Grid.Column="1" Style="{DynamicResource topButton}" Click="maximizingButton_Click">
                    <Icon:PackIconMaterial Kind="WindowMaximize" Width="15" Height="15"/>
                </Button>
                <Button x:Name="closeButton" Grid.Column="2" Style="{DynamicResource topButton}" Click="closeButton_Click_1">
                    <Icon:PackIconMaterial Kind="Close" Width="15" Height="15"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#465C2E" CornerRadius="0 50 0 30">
                <DockPanel>
                    <!--Menu logo-->
                    <Border Width="80" Height="80" Padding="3" Background="White" CornerRadius="100"
                            DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="20 -30 0 0">
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Images/Logo_zonafitness-modified.png" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>

                    <!--Titulo del menú-->
                    <TextBlock Text="Gimnasio Zona Fitness" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               DockPanel.Dock="Top" TextAlignment="Center" />
                    <!--Separador del menú-->
                    <Separator Margin="25" DockPanel.Dock="Top" Height="0.8" Background="#465C2E"/>
                    <!--Botones del menú-->
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="InicioButton" Style="{StaticResource menuButton}" Click="InicioButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="WeightKilogram" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Inicio"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!--Boton miembros-->
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="miembrosButton" Style="{StaticResource menuButton}" Click="miembrosButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="AccountMultipleOutline" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Miembros"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!--Boton pagos-->
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="pagosButton" Style="{StaticResource menuButton}" Click="pagosButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="CashMultiple" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Pagos"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!--Boton membresías-->
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="membresiasButton" Style="{StaticResource menuButton}" Click="membresiasButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="WalletMembership" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Membresías"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!--Boton Visitas-->
                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="visitasButton" Style="{StaticResource menuButton}" Click="visitasButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Account" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Visitas"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!--Boton Visitas-->
                    <StackPanel VerticalAlignment="Bottom" DockPanel.Dock="Top">
                        <Button x:Name="accesoButton"  Style="{StaticResource menuButton}" Click="acessoButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Application" Style="{StaticResource menuButtonIcon}"/>
                                <TextBlock Text="Sistema de acceso"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </DockPanel>
                
            </Border>
            <ContentControl x:Name="MainContent"
                Grid.Column="1"
                Grid.Row="1"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
        </Grid>
        
    </Border>
</Window>
