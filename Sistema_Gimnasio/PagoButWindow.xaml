<Window x:Class="Sistema_Gimnasio.PagoButWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Registrar Pago" Height="400" Width="350"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Membresía:" FontWeight="Bold"/>
        <ComboBox x:Name="cmbMembresias" Grid.Row="1" SelectionChanged="cmbMembresias_SelectionChanged" Margin="0,5"/>

        <TextBlock Grid.Row="2" Text="Precio:" FontWeight="Bold" Margin="0,10,0,0"/>
        <TextBox x:Name="txtPrecio" Grid.Row="3" IsReadOnly="True" Margin="0,5"/>

        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,10,0,0">
            <Label Content="Fecha de Pago:"/>
            <DatePicker x:Name="datePickerPago" SelectedDate="{x:Static sys:DateTime.Now}"/>
            <Button Content="Registrar Pago" Click="regPagoButton_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
