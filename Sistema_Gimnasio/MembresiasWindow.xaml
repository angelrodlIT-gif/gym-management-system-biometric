<UserControl x:Class="Sistema_Gimnasio.Views.MembresiasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Sistema_Gimnasio"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!--Seccion Principal-->
    <Grid  Background="White" Grid.Column="1" Margin="0,20,-47,10" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="51*"/>
            <ColumnDefinition Width="26*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="63*" />
            <RowDefinition Height="auto" MinHeight="55" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="352*" MinHeight="300" />

        </Grid.RowDefinitions>
        <!--Titulo de la pagina-->
        <TextBlock Text="Membresias" Grid.Row="0" Grid.Column="0" FontSize="32" FontWeight="Bold" Margin="10,4,0,17"
                   HorizontalAlignment="Left" Foreground="Black" Width="200"/>
        <Button x:Name="addButton" Style="{StaticResource addButton}" Height="35" Margin="0,192,0,0" VerticalAlignment="Top" Click="addButton_Click" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="1" Width="150">
            <StackPanel Orientation="Horizontal">
                <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>
                <TextBlock Text="Agregar Membresia"/>
            </StackPanel>
        </Button>

        <!--Miembros datagrid  ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" -->
        <DataGrid     
               AutoGenerateColumns="False"
                Style="{DynamicResource DataGridStyle1}" 
                CellStyle="{DynamicResource DataGridCellStyle1}" 
                RowStyle="{DynamicResource DataGridRowStyle1}"
                Grid.Row="3"
                MinHeight="200"
                MaxWidth="700"
                x:Name="membershipsDataGrid" 
                SelectionChanged="membershipsDataGrid_SelectionChanged" 
                Margin="28,16,32,-11" 
                RenderTransformOrigin="0.5,0.5"
                ColumnWidth="*" 
                HeadersVisibility="Column" 
                HorizontalScrollBarVisibility="Auto"
                CanUserAddRows="False">
            <DataGrid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <RotateTransform/>
                </TransformGroup>
            </DataGrid.RenderTransform>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn CanUserResize="False" Width="auto">
                    <DataGridCheckBoxColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox/>
                        </DataTemplate>
                    </DataGridCheckBoxColumn.HeaderTemplate>
                </DataGridCheckBoxColumn>

                <DataGridTextColumn Header="Id" IsReadOnly="True" CanUserResize="False" Width="auto" Binding="{Binding id}" />
                <DataGridTemplateColumn Header="Membresia" IsReadOnly="True" Width="*" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="25" Height="25" CornerRadius="50" Margin="0 0 10 0" Background="red">
                                    <TextBlock Text = "..."
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Center" 
                                               Foreground="White" 
                                               Margin="0 0 0 1"
                                               />
                                </Border>
                                <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Duración" IsReadOnly="True" CanUserResize="False" Width="auto" Binding="{Binding Duracion}" />
                <DataGridTextColumn Header="Duración" IsReadOnly="True" CanUserResize="False" Width="auto" Binding="{Binding UnidadDuracion}" />
                <DataGridTextColumn Header="Precio" IsReadOnly="True" CanUserResize="False" Width="auto" Binding="{Binding Precio}"/>
                <DataGridTemplateColumn Header="Opciones" IsReadOnly="True" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="editButton" Style="{StaticResource gridEditButton}" Click="editButton_Click">
                                    <Icon:PackIconMaterial Kind="PencilOutline " Style="{StaticResource gridButtonIcon}"/>
                                </Button>
                                <Button x:Name="trashButton" Style="{StaticResource gridRemoveButton}" Click="trashButton_Click">
                                    <Icon:PackIconMaterial Kind="TrashCanOutline" Style="{StaticResource gridButtonIcon}"/>
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        <!--Selector de paginas-->
        <Border HorizontalAlignment="Left" Height="177" Margin="0,10,0,0" 
                Grid.Row="3" VerticalAlignment="Top" 
                Width="250" Grid.Column="1" 
                Background="#465C2E"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titulo del grid -->
                <TextBlock Text="Introducir nueva Membresia: "  
                      HorizontalAlignment="Center" Margin="0,0,0,10" 
                      Grid.Row="0" FontWeight="SemiBold"  />
                <!-- Fixed Rectangle with TextBlock -->
                <Grid Grid.Row="1" Width="250" Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="21*"/>
                        <ColumnDefinition Width="229*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nombre:" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="SemiBold" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="txtNombre" HorizontalAlignment="Left" 
                             Width="190" Foreground="Black" Style="{DynamicResource textbox}" Grid.Column="1" Margin="39,0,0,0"/>
                </Grid>
                <Grid Grid.Row="2" Width="250" Height="50">
                    <TextBlock Text="Duracion:" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtDuracion"  HorizontalAlignment="Left"
                 Width="116"  Foreground="Black" Style="{DynamicResource textbox}" Margin="61,0,0,0"/>
                </Grid>
                <ComboBox x:Name="cbUnidadTiempo" Width="50" Height="20" Margin="5" Grid.Row="2" HorizontalAlignment="Right">
                    <ComboBoxItem Content="Días" IsSelected="True"/>
                    <ComboBoxItem Content="Meses"/>
                </ComboBox>
                <Grid Grid.Row="3" Width="250" Height="50">
                    <TextBlock Text="Precio:" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtPrecio" HorizontalAlignment="Right" VerticalAlignment="Center " 
                 Width="190" Foreground="Black" Style="{DynamicResource textbox}"/>
                </Grid>
                <Separator Grid.Row="4" Background="#465C2E" Margin="0,0,10,0" />


            </Grid>
        </Border>
    </Grid>
</UserControl>
